#ifndef COMMON_TYPES_METALH
#define COMMON_TYPES_METALH

struct BroadCollision {
    uint2 indexPair;
    uint2 objPair;
    uint2 behaviorPair;
    uint2 shapePair;
};

struct NarrowCollision {
    uint2 indexPair;      // point, triangle
    uint2 objPair;        // queryObjId, targetObjId
    float4 collisionNormalAndDistance; // xyz: normal, w: distance
    uint2 behaviorPair;
    uint2 shapePair;
};
struct NarrowParams {
    uint numBroadCollisions;
    uint maxNumCollisions;
    float radius;
    float thickness;
    // P1: 1 ⇒ skip every broad row whose either lane carries a non-Mesh
    // ColliderKind (the analytic narrow kernel feeds those instead).
    // 0 ⇒ analytic colliders flow through the triangle soup unchanged
    // (the SH / multi-level-SH broad paths, which emit no analytic
    // markers — see collider_pipeline_rework.md §5 P1 / decision 3).
    uint skipAnalytic;
};

// P1 — per-collider analytic descriptor. MUST match the C++
// AnalyticShape (include/sim/collision_pod.hpp) byte layout:
// 5×float4 then 4×uint (96 bytes, 16-aligned). tinym::vec4 ↔ float4
// is the same ABI already used for NarrowCollision.collisionNormal.
//
// `prevCenterPad.xyz` / `prevRotQuat` are the shape transform at the
// START of the step the CCD segment spans (rolled by
// Scene::refreshAnalyticShapes); the motion-inversion narrow kernel
// maps the vertex's x_prev through THEM and x_cur through
// centerRadius/rotQuat, turning a moving shape into a static canonical
// one (collider_pipeline_rework.md §3).
struct AnalyticShape {
    float4 centerRadius;   // xyz world center, w radius (sphere/cyl)
    float4 halfExtHeight;  // xyz half-extents (box/ellipsoid), w cyl half-height
    float4 rotQuat;        // world orientation w,x,y,z (local→world)
    float4 prevCenterPad;  // xyz prev-step center, w pad
    float4 prevRotQuat;    // prev-step orientation w,x,y,z
    uint kind;             // ColliderKind: 0 Mesh,1 Sphere,2 Box,3 Cyl,4 Plane
    uint objIndex;         // owning mesh ARRAY INDEX (== objPair namespace, §4)
    uint behaviorType;
    uint flags;            // bit0 = collidable
};

// Per-(cloth-mesh, collider) dispatch params for narrow_pt_analytic.
// One dispatch per broad-marked (cloth, analytic) object pair, so the
// kernel tests a SINGLE AnalyticShape (shapeIndex) instead of looping
// the whole array — broad phase already decided the overlap.
struct AnalyticNarrowParams {
    uint  oid;             // owning cloth mesh INDEX (== objPair.query subscript)
    uint  numVerts;        // cloth vertex count (thread domain)
    uint  shapeIndex;      // compact AnalyticShape[] index for this pair
    uint  maxNumCollisions;
    uint  clothBehavior;   // BehaviorType for behaviorPair (debug/A5)
    float radius;
    float thickness;
    // Rotation-linearization margin, CPU-computed per pair:
    // theta * (r_max + radius + thickness) with theta = the shape's
    // angular delta over the step. Motion inversion is EXACT for
    // translation and 1st-order for rotation; this term inflates the
    // contact band so the linearization can only over-report. Zero for
    // a non-rotating shape (every v1 scene).
    float rotMargin;
};

// ColliderKind enum values — MUST match ColliderKind in
// include/sim/collision_pod.hpp. NOTE these are NOT ShapeType values:
// the collision pipeline's shapePair lanes carry ColliderKind from P1
// on (collider_pipeline_rework.md, decision 1). ShapeType survives only
// as initializer classification / display metadata.
#define YSIM_COLLIDER_MESH     0u
#define YSIM_COLLIDER_SPHERE   1u
#define YSIM_COLLIDER_BOX      2u
#define YSIM_COLLIDER_CYLINDER 3u
#define YSIM_COLLIDER_PLANE    4u

#endif
